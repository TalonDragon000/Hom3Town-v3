# Alchemy Account Kit Configuration
# Get your API key from https://dashboard.alchemy.com/
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Wallet Connect Project ID
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id_here

# Pinata Configuration (for IPFS storage)
# Get your JWT from https://app.pinata.cloud/
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt_here
NEXT_PUBLIC_PINATA_GATEWAY=your_gateway_subdomain.mypinata.cloud

# Shape Sepolia NFT Contract Configuration
# Deploy the Hom3Town NFT contract to Shape Sepolia and add the address here
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Base URI for default avatars (before minting)
# This should point to a hosted default avatar metadata/image
NEXT_PUBLIC_DEFAULT_AVATAR_BASE_URI=https://gateway.pinata.cloud/ipfs/YOUR_DEFAULT_AVATAR_CID

# Alchemy Gas Manager Configuration (OPTIONAL)
# If provided, first mints will be sponsored (move-in celebration)
# Get your policy ID from https://dashboard.alchemy.com/gas-manager
NEXT_PUBLIC_GAS_POLICY_ID=

# BLOCKERS / MANUAL SETUP REQUIRED:
# 
# 1. DEPLOY CONTRACT
#    - Deploy Hom3Town NFT contract to Shape Sepolia testnet
#    - Contract repo: https://github.com/TalonDragon000/Hom3Town-Contracts
#    - Update NEXT_PUBLIC_NFT_CONTRACT_ADDRESS with deployed address
#
# 2. FAUCET (Get Shape Sepolia testnet tokens)
#    - Visit https://shapescan.xyz/faucet or https://www.alchemy.com/faucets/shape-sepolia
#    - Fund your wallet for gas fees (if not using Gas Manager)
#
# 3. GAS MANAGER SETUP (OPTIONAL - for sponsored first mints)
#    - Create policy at https://dashboard.alchemy.com/gas-manager
#    - Add policy ID to NEXT_PUBLIC_GAS_POLICY_ID
#    - Configure policy rules (e.g., first mint per address only)
#
# 4. DEFAULT AVATAR SETUP
#    - Upload a default avatar image/metadata to IPFS
#    - Update NEXT_PUBLIC_DEFAULT_AVATAR_BASE_URI
#
# 5. PINATA SETUP
#    - Create account at https://app.pinata.cloud/
#    - Generate API JWT with upload permissions
#    - Add custom gateway subdomain or use default
